# Telegram Bot Token ទទួលបានពី @BotFather
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Google Gemini API Key ទទួលបានពី https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ម៉ោងផ្ញើមាតិកាស្វ័យប្រវត្តិតាមថ្ងៃ (24-hour format: ឧទាហរណ៍ 08:00 សម្រាប់ម៉ោង 8 ព្រឹក)
DAILY_TIME=08:00

# Timezone (លំនាំដើម: Asia/Phnom_Penh)
TIMEZONE=Asia/Phnom_Penh

# SQLite Database Path (Default: bot_database.sqlite3)
# NOTE: SQLite on an ephemeral hosting filesystem (e.g. Render free tier) is NOT durable
# across container replacement/redeployment. Persistent disk or external storage is required for durability.
BOT_DB_PATH=bot_database.sqlite3
